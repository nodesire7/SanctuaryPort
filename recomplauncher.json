{
  "$schema": "https://recomplauncher.com/schema/recomplauncher.json",
  "format": 1,
  "name": "SanctuaryPort",
  "repo": "nodesire7/SanctuaryPort",
  "game": {
    "kind": "folder",
    "label": "您提供的《暗黑破坏神III》游戏目录，目录内含 eboot.bin。",
    "check": { "file": "eboot.bin" },
    "update": {
      "into": "update",
      "label": "游戏的 1.47 更新目录。",
      "accepts": "folder",
      "optional": true
    }
  },
  "start": {
    "program": ["SanctuaryPort.exe", "SanctuaryPort-linux-x86_64.AppImage"],
    "args": ["--play", "--game", "{game}", "--update", "{install}/update"]
  },
  "config": [
    {
      "id": "main",
      "format": "ini",
      "file": [
        { "path": "{install}/sanctuary.ini", "if": "{install}/SanctuaryPort.exe" },
        { "path": "{local}/sanctuaryport/sanctuary.ini" }
      ]
    }
  ],
  "saves": ["{install}/user/savedata", "{local}/sanctuaryport/user/savedata"],
  "folders": {
    "saves": [
      { "path": "{install}/user/savedata", "if": "{install}/SanctuaryPort.exe" },
      { "path": "{local}/sanctuaryport/user/savedata" }
    ],
    "logs": [
      { "path": "{install}/user", "if": "{install}/SanctuaryPort.exe" },
      { "path": "{local}/sanctuaryport/user" }
    ]
  },
  "settings": [
    {
      "id": "display_mode",
      "label": "显示模式",
      "choices": [
        { "label": "窗口", "set": { "display_mode": "windowed" } },
        { "label": "无边框", "set": { "display_mode": "borderless" } },
        { "label": "全屏", "set": { "display_mode": "fullscreen" } }
      ],
      "defaults": { "display_mode": "windowed" }
    },
    {
      "id": "render_resolution",
      "label": "渲染分辨率",
      "help": "游戏内部渲染分辨率。原生设置为 PS4 的 1080p。",
      "choices": [
        { "label": "720p", "set": { "render_resolution": "720p" } },
        { "label": "原生（1080p）", "set": { "render_resolution": "native" } },
        { "label": "1440p", "set": { "render_resolution": "1440p" } },
        { "label": "4K", "set": { "render_resolution": "4K" } }
      ],
      "defaults": { "render_resolution": "native" }
    },
    {
      "id": "upscaler",
      "label": "画面放大",
      "help": "画面放大与抗锯齿选项，实际可用效果取决于游戏配置。",
      "choices": [
        { "label": "关闭", "set": { "upscaler": "off" } },
        { "label": "FSR 3.1", "set": { "upscaler": "fsr3" } },
        { "label": "TAA", "set": { "upscaler": "taa" } }
      ],
      "defaults": { "upscaler": "off" }
    },
    {
      "id": "anti_aliasing",
      "label": "抗锯齿",
      "choices": [
        { "label": "关闭", "set": { "anti_aliasing": "off" } },
        { "label": "FXAA", "set": { "anti_aliasing": "fxaa" } },
        { "label": "SMAA", "set": { "anti_aliasing": "smaa" } }
      ],
      "defaults": { "anti_aliasing": "off" }
    },
    {
      "id": "vsync",
      "label": "垂直同步",
      "choices": [
        { "label": "开启", "set": { "vsync": "1" } },
        { "label": "关闭", "set": { "vsync": "0" } }
      ],
      "defaults": { "vsync": "1" }
    },
    {
      "id": "fps_limit",
      "label": "帧率上限",
      "choices": [
        { "label": "30", "set": { "fps_limit": "30" } },
        { "label": "60", "set": { "fps_limit": "60" } },
        { "label": "120", "set": { "fps_limit": "120" } },
        { "label": "144", "set": { "fps_limit": "144" } },
        { "label": "不限", "set": { "fps_limit": "0" } }
      ],
      "defaults": { "fps_limit": "0" }
    }
  ]
}
